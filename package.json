{
  "name": "comick-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "bin": { "comick-mcp": "dist/index.js" },
  "files": ["dist/"],
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "login": "node --env-file-if-exists=.env dist/oauth.js",
    "ui": "node --env-file-if-exists=.env dist/ui.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test .test-build/test.js",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
